{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":dependencyDashboard"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Alpine branch of the melange build environment (musl Rust). Both repository lines move together",
      "managerFilePatterns": [
        "/^melange\\.yaml$/"
      ],
      "matchStrings": [
        "https://dl-cdn\\.alpinelinux\\.org/alpine/v(?<currentValue>\\d+\\.\\d+)/"
      ],
      "depNameTemplate": "alpine",
      "datasourceTemplate": "docker",
      "versioningTemplate": "loose"
    }
  ],
  "packageRules": [
    {
      "description": "Conventional Commit types decide releases (release-please): crate and toolchain bumps ship as patch releases, action bumps don't release",
      "matchManagers": [
        "cargo",
        "devbox",
        "github-actions",
        "custom.regex"
      ],
      "semanticCommits": "enabled"
    },
    {
      "description": "Alpine branch bumps change the Rust compiler that builds the release: review by hand",
      "matchDepNames": [
        "alpine"
      ],
      "matchManagers": [
        "custom.regex"
      ],
      "dependencyDashboardApproval": true,
      "semanticCommitType": "build",
      "semanticCommitScope": "deps"
    },
    {
      "description": "Rust crates: lockfile refresh weekly, one PR",
      "matchManagers": [
        "cargo"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor",
        "lockFileMaintenance"
      ],
      "groupName": "rust crates",
      "semanticCommitType": "fix",
      "semanticCommitScope": "deps"
    },
    {
      "description": "Build toolchain (devbox: rust, melange, apko, cosign, ...) in one PR",
      "matchManagers": [
        "devbox"
      ],
      "groupName": "build toolchain",
      "semanticCommitType": "fix",
      "semanticCommitScope": "deps"
    },
    {
      "description": "GitHub Actions digest/version bumps in one PR",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions",
      "semanticCommitType": "ci",
      "semanticCommitScope": "deps"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on monday"
    ]
  },
  "semanticCommits": "enabled"
}
